  "metadata": "{\"compiler\":{\"version\":\"0.8.20+commit.a1b79de6\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"inputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"constructor\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"address\",\"name\":\"owner\",\"type\":\"address\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"spender\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"value\",\"type\":\"uint256\"}],\"name\":\"Approval\",\"type\":\"event\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"address\",\"name\":\"from\",\"type\":\"address\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"value\",\"type\":\"uint256\"}],\"name\":\"Transfer\",\"type\":\"event\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"_owner\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"spender\",\"type\":\"address\"}],\"name\":\"allowance\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"spender\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"value\",\"type\":\"uint256\"}],\"name\":\"approve\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"account\",\"type\":\"address\"}],\"name\":\"balanceOf\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"value\",\"type\":\"uint256\"}],\"name\":\"burn\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"decimals\",\"outputs\":[{\"internalType\":\"uint8\",\"name\":\"\",\"type\":\"uint8\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"value\",\"type\":\"uint256\"}],\"name\":\"mint\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"name\",\"outputs\":[{\"internalType\":\"string\",\"name\":\"\",\"type\":\"string\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"owner\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"symbol\",\"outputs\":[{\"internalType\":\"string\",\"name\":\"\",\"type\":\"string\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"totalSupply\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"value\",\"type\":\"uint256\"}],\"name\":\"transfer\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"from\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"value\",\"type\":\"uint256\"}],\"name\":\"transferFrom\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{},\"version\":1}},\"settings\":{\"compilationTarget\":{\"contracts/FJYToken.sol\":\"FJYToken\"},\"evmVersion\":\"paris\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\",\"useLiteralContent\":true},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[]},\"sources\":{\"contracts/FJYToken.sol\":{\"content\":\"// SPDX-License-Identifier: MIT\\npragma solidity >=0.8.0 <0.9.0;\\n\\ncontract FJYToken {\\n// ---------- \\u5143\\u6570\\u636e ----------\\nstring public name = \\\"FJYToken\\\";\\nstring public symbol = \\\"FJY202430550391\\\";\\nuint8 public decimals = 18;\\nuint256 public totalSupply;\\n\\n// ---------- \\u6743\\u9650 ----------\\naddress public owner;\\n\\nmodifier onlyOwner() {\\nrequire(msg.sender == owner, \\\"FJYToken: caller is not the owner\\\");\\n_;\\n}\\n\\n// ---------- \\u72b6\\u6001 ----------\\n// \\u8fd9\\u4e24\\u4e2a mapping \\u5c31\\u662f\\\"\\u8d26\\u672c\\\"\\u3002\\u4ee3\\u5e01\\u4e0d\\u5b58\\u5728\\u4e8e\\u4efb\\u4f55\\u94b1\\u5305\\u91cc\\uff0c\\u53ea\\u5b58\\u5728\\u4e8e\\u8fd9\\u91cc\\u3002\\nmapping(address => uint256) private _balances;\\nmapping(address => mapping(address => uint256)) private _allowances;\\n\\n// ---------- \\u4e8b\\u4ef6 ----------\\nevent Transfer(address indexed from, address indexed to, uint256 value);\\nevent Approval(address indexed owner, address indexed spender, uint256 value);\\n\\nconstructor() {\\nowner = msg.sender;\\n}\\n\\n// ---------- \\u53ea\\u8bfb\\u67e5\\u8be2 ----------\\nfunction balanceOf(address account) public view returns (uint256) {\\nreturn _balances[account];\\n}\\n\\nfunction allowance(address _owner, address spender) public view returns (uint256) {\\nreturn _allowances[_owner][spender];\\n}\\n\\n// ---------- TODO 1\\uff1a\\u8f6c\\u8d26 ----------\\n// \\u8981\\u6c42\\uff1ato \\u4e0d\\u80fd\\u662f\\u96f6\\u5730\\u5740\\uff1bmsg.sender \\u4f59\\u989d\\u5fc5\\u987b\\u8db3\\u591f\\uff1b\\n// \\u6263 msg.sender\\u3001\\u52a0 to\\uff1b\\u53d1\\u51fa Transfer \\u4e8b\\u4ef6\\uff1b\\u8fd4\\u56de true\\u3002\\nfunction transfer(address to, uint256 value) public returns (bool) {\\n    //\\u5148\\u68c0\\u67e5to\\u662f\\u5426\\u4e3a\\u96f6\\u5730\\u5740\\n    require(to != address(0),\\\"FJYToken:cannot transfer to the zero address\\\");\\n    //\\u518d\\u68c0\\u67e5msg.sender\\u4f59\\u989d\\u662f\\u5426\\u5145\\u8db3\\n    require(balanceOf(msg.sender) >= value,\\\"FJYToken:The sender doesn't have enough balance\\\");\\n\\n    //\\u6267\\u884c\\u8f6c\\u8d26\\u64cd\\u4f5c\\n    _balances[msg.sender] -= value;\\n    _balances[to] += value;\\n    emit Transfer(msg.sender,to,value);\\n\\n    return true;\\n}\\n\\n// ---------- TODO 2\\uff1a\\u6388\\u6743 ----------\\n// \\u8981\\u6c42\\uff1a\\u8bb0\\u5f55 msg.sender \\u5141\\u8bb8 spender \\u82b1 value\\uff1b\\u53d1\\u51fa Approval \\u4e8b\\u4ef6\\uff1b\\u8fd4\\u56de true\\u3002\\nfunction approve(address spender, uint256 value) public returns (bool) {\\n    _allowances[msg.sender][spender] = value;\\n    emit Approval(msg.sender,spender,value);\\n    return true;\\n}\\n\\n// ---------- TODO 3\\uff1a\\u4ee3\\u6263\\u8f6c\\u8d26 ----------\\n// \\u8981\\u6c42\\uff1afrom \\u7684\\u4f59\\u989d\\u5fc5\\u987b\\u8db3\\u591f\\uff1bmsg.sender \\u5728 from \\u5904\\u7684\\u989d\\u5ea6\\u5fc5\\u987b\\u8db3\\u591f\\uff1b\\n// \\u989d\\u5ea6\\u51cf value\\uff1b\\u6263 from\\u3001\\u52a0 to\\uff1b\\u53d1\\u51fa Transfer \\u4e8b\\u4ef6\\uff1b\\u8fd4\\u56de true\\u3002\\nfunction transferFrom(address from, address to, uint256 value) public returns (bool) {\\n    //\\u5148\\u68c0\\u67e5from\\u7684\\u4f59\\u989d\\u662f\\u5426\\u5145\\u8db3\\n    require(balanceOf(from) >= value,\\\"FJYToken:The sender doesn't have enough balance\\\");\\n    //\\u518d\\u68c0\\u67e5msg.sender\\u5728from\\u5904\\u7684\\u989d\\u5ea6\\u662f\\u5426\\u5145\\u8db3\\n    require(allowance(from, msg.sender) >= value,\\\"FJYToken:Insufficient limit at the source\\\");\\n\\n    //\\u6267\\u884c\\u4ee3\\u6263\\u8f6c\\u8d26\\u64cd\\u4f5c\\n    _allowances[from][msg.sender] -= value;\\n    _balances[from] -= value;\\n    _balances[to] += value;\\n    emit Transfer(from,to,value);\\n\\n    return true;\\n}\\n\\n// ---------- TODO 4\\uff1a\\u589e\\u53d1\\uff08\\u53ea\\u6709 owner \\u80fd\\u8c03\\uff09 ----------\\n// \\u8981\\u6c42\\uff1ato \\u4e0d\\u80fd\\u662f\\u96f6\\u5730\\u5740\\uff1btotalSupply \\u52a0 value\\uff1bto \\u4f59\\u989d\\u52a0 value\\uff1b\\n// \\u53d1\\u51fa Transfer \\u4e8b\\u4ef6\\uff0cfrom \\u586b address(0)\\u3002\\nfunction mint(address to, uint256 value) public onlyOwner {\\n    //\\u68c0\\u67e5to\\u662f\\u5426\\u4e3a\\u96f6\\u5730\\u5740\\n    require(to != address(0),\\\"FJYToken:cannot transfer to the zero address\\\");\\n\\n    //\\u6267\\u884c\\u589e\\u53d1\\u64cd\\u4f5c\\n    totalSupply += value;\\n    _balances[to] += value;\\n    emit Transfer(address(0),to,value);\\n}\\n\\n// ---------- TODO 5\\uff1a\\u9500\\u6bc1\\u81ea\\u5df1\\u7684\\u4ee3\\u5e01 ----------\\n// \\u8981\\u6c42\\uff1amsg.sender \\u4f59\\u989d\\u5fc5\\u987b\\u8db3\\u591f\\uff1b\\u4f59\\u989d\\u51cf value\\uff1btotalSupply \\u51cf value\\uff1b\\n// \\u53d1\\u51fa Transfer \\u4e8b\\u4ef6\\uff0cto \\u586b address(0)\\u3002\\nfunction burn(uint256 value) public {\\n    //\\u68c0\\u67e5msg.sender\\u4f59\\u989d\\u662f\\u5426\\u5145\\u8db3\\n    require(balanceOf(msg.sender) >= value,\\\"FJYToken:The sender doesn't have enough balance\\\");\\n\\n    //\\u6267\\u884c\\u9500\\u6bc1\\u64cd\\u4f5c\\n    _balances[msg.sender] -= value;\\n    totalSupply -= value;\\n    emit Transfer(msg.sender,address(0),value);\\n}\\n}\\n\",\"keccak256\":\"0x5aedd49ba402be75948b0510ac240826dc853a1ad0834cca64016a78ae4835cc\",\"license\":\"MIT\"}},\"version\":1}",
